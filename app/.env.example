# Public, client-side values only. NEVER put private keys here.
VITE_NETWORK=devnet            # devnet | local | mainnet
VITE_MAINNET_ENABLED=false     # mainnet stays disabled unless the owner explicitly approves
VITE_RPC_URL=                  # optional public/rate-limited RPC (visible to browsers)
VITE_COIN_MINT=                # NEW coin mint on the selected network
VITE_CLAWD_MINT=               # quote mint (mainnet: 8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump)
VITE_LAUNCH_AT=                # ISO timestamp for countdown, empty = awaiting approval
